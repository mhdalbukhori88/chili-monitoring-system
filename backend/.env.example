# ==============================================================
# Chili Monitoring System - Backend Environment Configuration
# ==============================================================

# Database Connection:
# Local Development (SQLite):
# DATABASE_URL=sqlite:///./chili_monitoring.db
# Production (PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chili_monitoring

# JWT Authentication Security:
# Ganti JWT_SECRET dengan string acak yang kuat (mis. openssl rand -hex 32)
JWT_SECRET=production-secret-chili-monitoring-replace-with-secure-random-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Agronomist Assistant (Opsional - jika dikosongkan, menggunakan Rule-Based Agronomy Engine bawaan):
ANTHROPIC_API_KEY=

# Storage Directory for Uploaded Chili Images:
UPLOAD_DIR=app/uploads
